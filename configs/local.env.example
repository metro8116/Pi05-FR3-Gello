# Copy to configs/local.env. Shell syntax; this file is sourced by run.sh.
# Paths may be absolute; if unset, use this NEW repository's own environments.
# export PI05_ROBOT_PYTHON="/absolute/path/to/existing/robot/bin/python"
# export PI05_CONVERTER_PYTHON="/absolute/path/to/existing/converter/bin/python"
# export PI05_ML_PYTHON="/absolute/path/to/existing/ml/bin/python"
export PI05_DOCKER_HOST="unix:///var/run/docker.sock"
export PI05_CONTAINER="pi05-fr3-gello-ros2-1"
export FRANKA_IP="172.16.0.2"
export LOCAL_ROS2_DOCKER_HOST="$PI05_DOCKER_HOST"
export TAKE_DATA_CAMERA_SERIALS="233522074047,405622074065"
# Deployment overrides: copy deploy/configs/deploy.yaml to deploy/configs/local.yaml.
# export PI05_CONFIG="$PI05_REPO_ROOT/deploy/configs/local.yaml"
# Keep fault locks until a hardware fault has actually been inspected/repaired.
# export FR3_HARDWARE_FAULT_LOCK="/absolute/path/to/shared/gripper_hardware_fault.lock"
# Automatic dual-camera deployment videos; default deploy/recordings/.
# export PI05_RECORDING_DIR="/absolute/path/on/a/disk/with/free/space"
# If reusing an old robot environment without imageio-ffmpeg:
# export PI05_FFMPEG="/absolute/path/to/an/existing/ffmpeg"
