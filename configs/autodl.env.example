# Copy to configs/autodl.env on each relevant machine; never commit it.
# Local robot PC: AutoDL's SSH endpoint (not the FR3 IP).
export PI05_SSH_HOST="YOUR_AUTODL_SSH_HOST"
export PI05_SSH_PORT="YOUR_AUTODL_SSH_PORT"
export PI05_SSH_USER="root"
export PI05_LOCAL_PORT="18000"
export PI05_REMOTE_PORT="8000"
# GPU host: point to EXISTING files. Prefer an exact HF snapshots/<hash> directory.
# export PI05_BASE_MODEL="/root/autodl-tmp/hf-cache/hub/models--lerobot--pi05_base/snapshots/YOUR_HASH"
# export PI05_TOKENIZER="google/paligemma-3b-pt-224"
# export PI05_DATASET="$PI05_REPO_ROOT/data/lerobot/fr3_avocado_v30"
# export PI05_CHECKPOINT="/absolute/path/to/outputs/checkpoints/008000/pretrained_model"
# export PI05_ML_PYTHON="/absolute/path/to/existing/.venv/bin/python"
